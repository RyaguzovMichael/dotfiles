{
  "layer": "left",
  "position": "top",
  "height": 42,
  "spacing": 4,
  "modules-left": ["custom/arch", "hyprland/workspaces"],
  "modules-center": ["hyprland/window"],
  "modules-right": [
    "pulseaudio",
    "network",
    "cpu",
    "memory",
    "temperature",
    "hyprland/language",
    "clock"
  ],
  "include": ["~/.config/waybar/modules.json"]
}
